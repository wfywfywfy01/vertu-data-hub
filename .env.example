# ========== 数据库 ==========
APP_ENV=development
# 开发阶段：docker compose 起的本地 pgvector 库（宿主机访问用 localhost:5434）
# 正式环境：替换为云 RDS 连接串，代码不变
DATABASE_URL=postgresql://datahub:datahub@localhost:5434/vertu_data_hub

# ========== 文本 Embedding ==========
# provider: api（OpenAI 兼容 embedding 接口）/ hash（开发兜底，无需外部服务）
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=10

# ========== 图片（多模态）Embedding ==========
IMAGE_EMBEDDING_PROVIDER=hash
IMAGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_EMBEDDING_API_KEY=
IMAGE_EMBEDDING_MODEL=multimodal-embedding-v1
IMAGE_EMBEDDING_DIM=1024
# 默认禁止把原图发给第三方。仅 internal 资料在显式开启后可调用云图片 embedding。
ALLOW_EXTERNAL_IMAGE_PROCESSING=false

# 本地中文图文检索。首次部署先运行 python -m app.cli.preload_semantic_images。
SEMANTIC_IMAGE_BATCH_SIZE=4
SEMANTIC_IMAGE_PRELOAD=true

# ========== 本地音视频处理 ==========
MEDIA_TRANSCRIPTION_MODEL=small
MEDIA_TRANSCRIPTION_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
MEDIA_TRANSCRIPTION_COMPUTE_TYPE=int8
MEDIA_KEYFRAME_INTERVAL_SECONDS=30
MEDIA_MAX_KEYFRAMES=60

# ========== 有引用回答（OpenRouter / DeepSeek） ==========
# 默认关闭。开启后也只发送脱敏后的 internal 证据。
ANSWER_PROVIDER=disabled
ALLOW_EXTERNAL_TEXT_GENERATION=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Vertu Dealer Knowledge
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANSWER_MIN_SEMANTIC_SIMILARITY=0.35

# ========== 数据落地目录（文件类数据源监听的根目录） ==========
WATCHED_ROOT=D:\vertu-agent-数据待处理

# ========== OSS 原文件信箱（生产） ==========
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=
OSS_SIGNED_URL_SECONDS=900

# ========== PDCA 私有 API 鉴权 ==========
SERVICE_TOKEN_ISSUER=pdca-workbench
SERVICE_TOKEN_AUDIENCE=dealer-knowledge-hub
# 开发可填至少 32 字节；生产留空并使用 SERVICE_TOKEN_KEY_FILE 挂载密钥。
SERVICE_TOKEN_SECRET=
SERVICE_TOKEN_KEY_FILE=
# 生产 Compose 使用外部 Docker 卷 dealer-knowledge-secrets，PDCA 只读共享。
# Production only: full image reference with sha256 digest or commit SHA tag.
DATA_HUB_IMAGE=

# ========== 备份 ==========
DATA_HUB_BACKUP_DIR_HOST=./backups
DATA_HUB_BACKUP_RETENTION=14

# ========== 异步任务 ==========
REDIS_URL=redis://localhost:6380/0

# ========== vertu-cli（skill 取数） ==========
VERTU_CLI_BIN=vertu-cli
