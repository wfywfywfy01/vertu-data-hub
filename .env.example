# ========== 数据库 ==========
APP_ENV=development
# 开发阶段：docker compose 起的本地 pgvector 库（宿主机访问用 localhost:5434）
# 正式环境：替换为云 RDS 连接串，代码不变
DATABASE_URL=postgresql://datahub:datahub@localhost:5434/vertu_data_hub

# ========== 文本 Embedding ==========
# provider: api（OpenAI 兼容 embedding 接口）/ hash（开发兜底，无需外部服务）
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ========== 图片（多模态）Embedding ==========
IMAGE_EMBEDDING_PROVIDER=hash
IMAGE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_EMBEDDING_API_KEY=
IMAGE_EMBEDDING_MODEL=multimodal-embedding-v1
IMAGE_EMBEDDING_DIM=1024

# ========== 数据落地目录（文件类数据源监听的根目录） ==========
WATCHED_ROOT=D:\vertu-agent-数据待处理

# ========== OSS 原文件信箱（生产） ==========
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=

# ========== vertu-cli（skill 取数） ==========
VERTU_CLI_BIN=vertu-cli
